# Self-contained: does not rely on any parent .gitignore.

# OS
.DS_Store
Thumbs.db
__MACOSX/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
*.log

# Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environments
.venv/
env/
venv/
__pypackages__/
.env
*.env

# Editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Local AI tool configuration
.agents/
.claude/
.codex

# LaTeX build artefacts (sources are tracked, PDFs are not)
*.aux
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg
*.nav
*.snm
*.vrb
*.lof
*.lot
*.pdfsync
*_minted*
*.pdf

# Generated output
out/

# External datasets (see data/README.md). data/two_view/ holds small tracked examples.
data/eth3d/
data/kitti_odometry/

# Keep data/ trackable when nested in a repository that ignores data/
!/data/
